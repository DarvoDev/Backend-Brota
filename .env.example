# Copia este archivo como .env y cambia TODOS los valores.
# El archivo .env nunca se sube al repositorio.

# Contraseña de PostgreSQL (la usa también DATABASE_URL dentro de docker-compose)
POSTGRES_PASSWORD=cambia-esta-contrasena

# Secreto para firmar los JWT (HS256). Usa una cadena larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BROTA_JWT_SECRETO=cambia-este-secreto

# Clave para cifrar los datos sincronizados (Fernet). Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la cambias, los datos ya guardados no se podrán descifrar.
BROTA_CLAVE_DATOS=cambia-esta-clave

# Cuenta de administrador que se crea al arrancar (si no existe)
ADMIN_CORREO=admin@brota.local
ADMIN_PASSWORD=cambia-esta-contrasena-admin

# Orígenes permitidos por CORS separados por coma ("*" = todos, solo desarrollo)
BROTA_CORS_ORIGENES=*

# Zona horaria para decidir "qué día es hoy"
BROTA_ZONA_HORARIA=America/Mexico_City

# Solo si ejecutas la API fuera de Docker (por defecto usa SQLite local):
# DATABASE_URL=postgresql+psycopg://brota:cambia-esta-contrasena@localhost:5432/brota
