# Plantilla de variables. Local: cópiala como .env. Portainer: pégala con tus valores en
# Stack → Environment variables ("Load variables from .env file").
# Los valores de abajo sirven para desarrollo; en un servidor cambia TODO lo marcado CAMBIAR.
# El archivo .env nunca se sube al repositorio.

# --- Secretos (obligatorios) ---
# Contraseña de PostgreSQL (con ella se arma DATABASE_URL dentro del compose)
POSTGRES_PASSWORD=CAMBIAR-brota-dev

# Secreto para firmar los JWT (HS256). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BROTA_JWT_SECRETO=CAMBIAR-secreto-de-desarrollo

# Clave para cifrar los datos sincronizados (Fernet). Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NO la cambies después del primer despliegue: lo ya guardado no se podría descifrar.
BROTA_CLAVE_DATOS=CAMBIAR-clave-de-datos-de-desarrollo

# Cuenta de administrador que se crea al arrancar (si no existe)
ADMIN_CORREO=admin@brota.local
ADMIN_PASSWORD=CAMBIAR-admin-brota-dev

# --- Puertos publicados en el host ---
# API en HTTP plano. API_IP=127.0.0.1 → solo el propio host (proxy externo, emulador 10.0.2.2);
# 0.0.0.0 → visible en la red (celular físico en la misma Wi-Fi, proxy en otro contenedor).
API_IP=127.0.0.1
API_PUERTO=8000
# Proxy HTTPS (Caddy). Con Let's Encrypt usa 443 y 80. Si ya hay otro proxy en 80/443,
# deja estos puertos libres (p. ej. 8443/8080) y apunta tu proxy a 127.0.0.1:API_PUERTO.
PROXY_IP=0.0.0.0
BROTA_PUERTO_HTTPS=8443
BROTA_PUERTO_HTTP=8080
# PostgreSQL, solo en 127.0.0.1 del host (pgAdmin / túnel SSH)
POSTGRES_PUERTO=5433

# --- HTTPS (Caddy) ---
# Dominio(s) o IP(s) del servidor, separados por coma
BROTA_SITIO=localhost, 127.0.0.1, 10.0.2.2
# "internal" = certificado autofirmado; un correo = Let's Encrypt (requiere dominio real)
BROTA_TLS=internal
# Nombre para clientes sin SNI (conexión por IP). Vacío = BROTA_SITIO
BROTA_SNI_DEFECTO=localhost

# --- Opcionales ---
# Orígenes permitidos por CORS separados por coma ("*" = todos)
BROTA_CORS_ORIGENES=*
# Zona horaria para decidir "qué día es hoy"
BROTA_ZONA_HORARIA=America/Mexico_City
# Nombre y usuario de la base (rara vez hace falta cambiarlos)
POSTGRES_DB=brota
POSTGRES_USER=brota

# Solo si ejecutas la API fuera de Docker (por defecto usa SQLite local):
# DATABASE_URL=postgresql+psycopg://brota:CAMBIAR-brota-dev@localhost:5433/brota
